# Copy to .env and edit. Never commit .env.

# Port the server listens on. In dev the Vite client proxies /api here.
PORT=4000

# Secret used to sign login session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Where the SQLite database file lives (relative paths resolve from the repo root).
DATABASE_PATH=data/ot.db

# Credentials for the single consultant account, used only on first run to
# create the account. After that, change the password from Settings.
INITIAL_USER_EMAIL=consultant@example.com
INITIAL_USER_PASSWORD=change-this-password
INITIAL_USER_NAME=Dr. Consultant

# Set to "true" only if you terminate TLS in front of the app (recommended in
# production) so the session cookie is marked Secure.
SECURE_COOKIES=false
